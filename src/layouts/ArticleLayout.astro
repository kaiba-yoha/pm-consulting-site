---
import BaseLayout from './BaseLayout.astro';
import CategoryLabel from '../components/ui/CategoryLabel.astro';
import TagBadge from '../components/ui/TagBadge.astro';
import AffiliateSidebar from '../components/ads/AffiliateSidebar.astro';
import AffiliateFooter from '../components/ads/AffiliateFooter.astro';
import { formatDate } from '../lib/utils';
import type { CollectionEntry } from 'astro:content';
import ogArticles from '../data/og-articles.json';

interface Props {
  post: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const { post, relatedPosts = [] } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, ogImage, noindex } = post.data;
// Per-article OG image when available, else fall back to the layout default.
const resolvedOgImage = ogImage ?? (ogArticles.includes(post.id) ? `/og/${post.id}.png` : undefined);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={resolvedOgImage}
  ogType="article"
  noindex={noindex}
>
  <!-- Scroll Progress Bar -->
  <div id="scroll-progress" style="width: 0%"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-6" aria-label="パンくずリスト">
      <a href="/" class="hover:text-primary-600 transition-colors">ホーム</a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary-600 transition-colors">記事一覧</a>
      <span>/</span>
      <a href={`/blog/category/${category}`} class="hover:text-primary-600 transition-colors">
        {category}
      </a>
      <span>/</span>
      <span class="text-text-base truncate max-w-48">{title}</span>
    </nav>

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-10">
      <!-- Article Content -->
      <article>
        <!-- Article Header -->
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-3">
            <CategoryLabel category={category} href={`/blog/category/${category}`} />
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-text-base leading-tight mb-2">
            {title}
          </h1>
          <p class="text-xs text-text-muted mb-4">本ページはプロモーションが含まれています</p>
          <p class="text-text-muted leading-relaxed mb-4">{description}</p>

          <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted pb-4 border-b border-border">
            <time datetime={pubDate.toISOString()} class="flex items-center gap-1">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="1" y="2" width="12" height="11" rx="1"/>
                <line x1="1" y1="6" x2="13" y2="6"/>
                <line x1="4" y1="1" x2="4" y2="4"/>
                <line x1="10" y1="1" x2="10" y2="4"/>
              </svg>
              {formatDate(pubDate)}
            </time>
            {updatedDate && (
              <span class="flex items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M1 7a6 6 0 1011.95-1M1 7V4M1 7H4"/>
                </svg>
                更新: {formatDate(updatedDate)}
              </span>
            )}
          </div>

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {tags.map(tag => (
                <TagBadge tag={tag} href={`/blog/tag/${tag}`} />
              ))}
            </div>
          )}
        </header>

        <!-- Article Body -->
        <div class="prose max-w-none">
          <slot />
        </div>

        <!-- Affiliate Footer -->
        <AffiliateFooter />

        <!-- Related Articles -->
        {relatedPosts.length > 0 && (
          <section class="mt-12 pt-8 border-t border-border">
            <h2 class="text-xl font-bold text-text-base mb-4">関連記事</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedPosts.map(related => (
                <a
                  href={`/blog/${related.id}`}
                  class="flex gap-3 p-4 bg-surface-card rounded-lg border border-border hover:shadow-sm transition-shadow group"
                >
                  <div class="flex-1 min-w-0">
                    <p class="text-xs text-text-muted mb-1">{formatDate(related.data.pubDate)}</p>
                    <p class="text-sm font-medium text-text-base group-hover:text-primary-600 transition-colors leading-snug">
                      {related.data.title}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="hidden lg:block">
        <AffiliateSidebar />
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const progressBar = document.getElementById('scroll-progress');

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) {
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
