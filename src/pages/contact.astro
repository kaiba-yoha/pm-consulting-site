---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="PMFlowへのお問い合わせフォーム。記事内容へのご指摘・ご質問・掲載依頼などお気軽にどうぞ。"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-text-base mb-4">お問い合わせ</h1>
      <div class="h-1 w-16 bg-accent-500 rounded-full"></div>
    </div>

    <p class="text-text-muted leading-relaxed mb-8">
      記事内容へのご指摘・ご質問、掲載に関するご相談などお気軽にお送りください。通常2〜3営業日以内にご返信します。
    </p>

    <div id="form-success" class="hidden rounded-lg border border-accent-500/40 bg-accent-500/5 px-5 py-4 mb-8 text-sm text-text-base">
      <p class="font-semibold">送信しました。</p>
      <p class="text-text-muted mt-1">ご返信まで今しばらくお待ちください。</p>
    </div>

    <div id="form-error" class="hidden rounded-lg border border-border bg-surface-card px-5 py-4 mb-8 text-sm text-text-muted">
      送信に失敗しました。時間をおいて再度お試しください。
    </div>

    <form id="contact-form" class="space-y-5 rounded-lg border border-border bg-surface-card p-6" novalidate>
      <div>
        <label for="name" class="block text-sm font-semibold text-text-base mb-1.5">お名前 <span class="text-accent-500">*</span></label>
        <input id="name" name="name" type="text" required placeholder="山田 太郎"
          class="w-full px-3 py-2 rounded border border-border bg-white text-sm text-text-base focus:border-accent-500 outline-none transition-colors" />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-text-base mb-1.5">メールアドレス <span class="text-accent-500">*</span></label>
        <input id="email" name="email" type="email" required placeholder="you@example.com"
          class="w-full px-3 py-2 rounded border border-border bg-white text-sm text-text-base focus:border-accent-500 outline-none transition-colors" />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-text-base mb-1.5">お問い合わせ内容 <span class="text-accent-500">*</span></label>
        <textarea id="message" name="message" rows="6" required placeholder="お問い合わせ内容をご記入ください。"
          class="w-full px-3 py-2 rounded border border-border bg-white text-sm text-text-base focus:border-accent-500 outline-none transition-colors resize-y"></textarea>
      </div>

      <label class="flex items-start gap-2 text-sm text-text-muted cursor-pointer">
        <input type="checkbox" required class="mt-1" />
        <span><a href="/privacy" class="text-primary-600 underline underline-offset-2">プライバシーポリシー</a>に同意する</span>
      </label>

      <button type="submit" id="submit-btn"
        class="px-6 py-2.5 rounded bg-primary-900 text-white text-sm font-semibold hover:bg-primary-800 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
        <span id="submit-label">送信する</span>
      </button>
    </form>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLDivElement;
  const error = document.getElementById('form-error') as HTMLDivElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const label = document.getElementById('submit-label') as HTMLSpanElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    btn.disabled = true;
    label.textContent = '送信中…';
    error.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('/api/contact', { method: 'POST', body: data });
      const json = await res.json();
      if (json.success) {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error(json.error ?? 'Submission failed');
      }
    } catch {
      error.classList.remove('hidden');
      btn.disabled = false;
      label.textContent = '送信する';
    }
  });
</script>
