---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categoryLabels } from '../lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const recentPosts = sortedPosts.slice(0, 6);

const categories = Object.keys(categoryLabels) as Array<keyof typeof categoryLabels>;
---

<BaseLayout
  title="PMFlow - コンサルティングPM向け実践メディア"
  description="AIワークフロー・フレームワーク・少人数チーム運営術。人員不足・炎上プロジェクトを抱えるPMへの実践的情報を発信します。"
  ogImage="/hero-workflow.jpg"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700 text-white">
    <img src="/hero-workflow.jpg" alt="プロジェクトの依存関係を表すネットワーク図" class="absolute inset-0 h-full w-full object-cover opacity-20" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900 via-primary-900/85 to-primary-800/50 pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-primary-700/60 border border-primary-600 rounded-full px-4 py-1.5 text-sm text-primary-200 mb-6">
          <span class="w-2 h-2 bg-accent-400 rounded-full"></span>
          コンサルティングPM向け実践メディア
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
          プロジェクトの<br />
          <span class="text-accent-400">複雑さ</span>を、<br />
          シンプルに制御する。
        </h1>
        <p class="text-lg text-primary-200 leading-relaxed mb-8 max-w-xl">
          AIワークフロー・フレームワーク・少人数チーム運営術。炎上プロジェクトを抱えるPMが今すぐ使える実践情報を発信します。
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            記事を読む
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
          <a
            href="/tools"
            class="inline-flex items-center gap-2 bg-primary-700 hover:bg-primary-600 text-white font-semibold px-6 py-3 rounded-lg border border-primary-600 transition-colors"
          >
            ツール紹介
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Grid -->
  <section class="bg-white border-b border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-wrap gap-2 justify-center">
        {categories.map(cat => (
          <a
            href={`/blog/category/${cat}`}
            class="flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-surface hover:bg-primary-50 hover:border-primary-300 transition-colors text-sm font-medium text-text-base"
          >
            {categoryLabels[cat]}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  {featuredPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-text-base">注目記事</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            slug={post.id}
            featured={true}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Recent Articles -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-text-base">最新記事</h2>
      <a href="/blog" class="text-sm text-primary-500 hover:text-primary-700 font-medium transition-colors">
        すべて見る →
      </a>
    </div>
    {recentPosts.length === 0 ? (
      <p class="text-text-muted text-center py-12">記事がありません。</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            slug={post.id}
          />
        ))}
      </div>
    )}
  </section>

  <!-- CTA Banner -->
  <section class="bg-primary-900 text-white mt-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <h2 class="text-2xl font-bold mb-3">PMの課題を一緒に解決しましょう</h2>
      <p class="text-primary-200 mb-6">AIを活用した効率化から、炎上プロジェクトの立て直しまで。実践的な情報をお届けします。</p>
      <a
        href="/about"
        class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        サイトについて
      </a>
    </div>
  </section>
</BaseLayout>
