---
const AMAZON_ASSOCIATE_ID = 'YOUR_AMAZON_ASSOCIATE_ID';

const sidebarItems = [
  {
    asin: 'B09PLACEHOLDER1',
    title: 'PMの鉄則 炎上プロジェクト対応ガイド',
    price: '¥2,200',
    type: 'book',
  },
  {
    asin: 'B09PLACEHOLDER2',
    title: 'AIで変わるプロジェクト管理',
    price: '¥1,980',
    type: 'book',
  },
];
---

<aside class="sticky top-24 space-y-4">
  <div class="bg-surface-card rounded-xl border border-border p-4">
    <h3 class="text-sm font-bold text-text-base mb-3 pb-2 border-b border-border">
      おすすめ書籍
    </h3>
    <div class="space-y-3">
      {sidebarItems.map(item => (
        <a
          href={`https://www.amazon.co.jp/dp/${item.asin}?tag=${AMAZON_ASSOCIATE_ID}`}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex gap-2 group"
        >
          <div class="w-10 h-14 bg-primary-100 rounded flex-shrink-0 flex items-center justify-center text-primary-400">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M3 2a1 1 0 011-1h8a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V2zm2 1v10h6V3H5z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-medium text-text-base group-hover:text-primary-600 transition-colors leading-snug mb-0.5">
              {item.title}
            </p>
            <p class="text-xs text-accent-600 font-semibold">{item.price}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- A8.net サイドバーバナー設置方法:
    下のdiv内にA8.netから取得したバナーHTMLを貼り付けてください。
    例: <a href="https://px.a8.net/..." target="_blank" rel="nofollow"><img src="..." /></a>
  -->
  <div class="bg-surface-card rounded-xl border border-border p-4 text-center text-xs text-text-muted">
    <!-- A8.net BANNER PLACEHOLDER -->
    <p class="text-text-muted text-xs">広告スペース</p>
  </div>
</aside>
