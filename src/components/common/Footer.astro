---
const currentYear = new Date().getFullYear();

const categories = [
  { href: '/blog/category/ai-workflow', label: 'AIワークフロー' },
  { href: '/blog/category/framework', label: 'フレームワーク' },
  { href: '/blog/category/team-management', label: 'チーム運営' },
  { href: '/blog/category/crisis-recovery', label: '炎上対策' },
  { href: '/blog/category/tools', label: 'ツール紹介' },
];
---

<footer class="bg-primary-950 text-primary-200 mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 bg-accent-500 rounded-md flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="6" height="6" rx="1" fill="white"/>
              <rect x="12" y="2" width="6" height="6" rx="1" fill="white"/>
              <rect x="2" y="12" width="6" height="6" rx="1" fill="white"/>
              <rect x="12" y="12" width="6" height="6" rx="1" fill="white" opacity="0.6"/>
              <line x1="8" y1="5" x2="12" y2="5" stroke="white" stroke-width="1.5"/>
              <line x1="10" y1="8" x2="10" y2="12" stroke="white" stroke-width="1.5"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-white">PMFlow</span>
        </a>
        <p class="text-sm leading-relaxed text-primary-300">
          コンサルティングPM向けの実践情報メディア。AIワークフロー・フレームワーク・少人数チーム運営術を発信します。
        </p>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">カテゴリ</h3>
        <ul class="space-y-2">
          {categories.map(cat => (
            <li>
              <a href={cat.href} class="text-sm text-primary-300 hover:text-accent-400 transition-colors">
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">サイト情報</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-primary-300 hover:text-accent-400 transition-colors">このサイトについて（運営者情報）</a></li>
          <li><a href="/tools" class="text-sm text-primary-300 hover:text-accent-400 transition-colors">おすすめツール</a></li>
          <li><a href="/blog" class="text-sm text-primary-300 hover:text-accent-400 transition-colors">全記事一覧</a></li>
          <li><a href="/privacy" class="text-sm text-primary-300 hover:text-accent-400 transition-colors">プライバシーポリシー</a></li>
          <li><a href="/contact" class="text-sm text-primary-300 hover:text-accent-400 transition-colors">お問い合わせ</a></li>
        </ul>
        <p class="mt-4 text-xs text-primary-400 leading-relaxed">
          ※当サイトはアフィリエイト広告を利用しています
        </p>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-primary-800 text-center text-xs text-primary-400">
      <p>&copy; {currentYear} PMFlow. All rights reserved.</p>
    </div>
  </div>
</footer>
